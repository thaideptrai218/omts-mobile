# Zalo Mini App ID, from Mini App Center (https://mini.zalo.me)
APP_ID=
# Deploy token, written by `npm run login` (zmp login). Never commit the real value.
ZMP_TOKEN=
# OMTS.Api base URL used by the app (no trailing slash). Leave empty for `npm start`: requests to /api are
# proxied by the dev server to API_PROXY_TARGET. Inside Zalo it must be HTTPS on a domain.
VITE_API_BASE_URL=
# Where the dev server forwards /api when VITE_API_BASE_URL is empty (the backend run locally).
API_PROXY_TARGET=http://localhost:5198
