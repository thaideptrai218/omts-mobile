# Base URL of omts-backend API (e.g. http://192.168.1.10:5000 when testing on a phone)
EXPO_PUBLIC_API_BASE_URL=

# Explicit mock-only UI flow. Unset for real API work (adapter not integrated yet).
# Never enter real credentials in mock mode. Restarting the app resets fixtures.
EXPO_PUBLIC_AUTH_MODE=mock

